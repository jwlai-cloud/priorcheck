# Copy to .env. Never commit real values.

# --- Google Cloud / Vertex AI ---
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True

# --- Parallel (the partner integration) ---
# Without this, verification serves offline sample sources and the UI says so.
# PARALLEL_API_KEY=...
# PARALLEL_PROCESSOR=base        # base ($4/1k) or pro ($9/1k)

# --- Ledger ---
# Unset -> in-memory. Set -> BigQuery claims ledger (durable audit trail).
# BIGQUERY_DATASET=sceneroom
